diff --git a/scripts/link_motion.gd b/scripts/link_motion.gd
new file mode 100644
--- /dev/null
+++ b/scripts/link_motion.gd
@@ -0,0 +1,64 @@
+extends RefCounted
+
+const LIMIT := 220.0
+const SPEED := 180.0
+const RADIUS := 12.0
+
+static func free_at(p: Vector2, walls: Array) -> bool:
+	for wall: Rect2 in walls:
+		if wall.grow(RADIUS).has_point(p):
+			return false
+	return true
+
+static func sweep(p: Vector2, motion: Vector2, walls: Array) -> Vector2:
+	# Small axis-separated sweeps allow sliding without tunnelling.
+	var result := p
+	for axis in [Vector2(motion.x, 0), Vector2(0, motion.y)]:
+		if free_at(result + axis, walls):
+			result += axis
+		else:
+			var low := 0.0
+			var high := 1.0
+			for iteration in range(12):
+				var middle := (low + high) * 0.5
+				if free_at(result + axis * middle, walls):
+					low = middle
+				else:
+					high = middle
+			result += axis * low
+	return result
+
+static func advance(a: Node2D, b: Node2D, input_a: Vector2, input_b: Vector2, delta: float, walls: Array) -> void:
+	var count := maxi(1, ceili(SPEED * delta / 2.0))
+	var da := input_a.limit_length() * SPEED * delta / count
+	var db := input_b.limit_length() * SPEED * delta / count
+	for step in range(count):
+		var pa := a.position
+		var pb := b.position
+		var ca := sweep(pa, da, walls)
+		var cb := sweep(pb, db, walls)
+		if ca.distance_to(cb) > LIMIT:
+			var ma := ca.distance_to(pa)
+			var mb := cb.distance_to(pb)
+			var total := ma + mb
+			if total > 0.00001:
+				var correction := (ca - cb).normalized() * (ca.distance_to(cb) - LIMIT + 0.00001)
+				var qa := ca - correction * ma / total
+				var qb := cb + correction * mb / total
+				# Corrections only modify this step's requested motion; never drag an idle twin.
+				if free_at(qa, walls) and free_at(qb, walls) and qa.distance_to(pa) <= da.length() + 0.001 and qb.distance_to(pb) <= db.length() + 0.001:
+					ca = qa
+					cb = qb
+				else:
+					var low := 0.0
+					var high := 1.0
+					for iteration in range(16):
+						var t := (low + high) / 2.0
+						if pa.lerp(ca, t).distance_to(pb.lerp(cb, t)) <= LIMIT:
+							low = t
+						else:
+							high = t
+					ca = pa.lerp(ca, low)
+					cb = pb.lerp(cb, low)
+		a.position = ca
+		b.position = cb
diff --git a/scripts/partner_ai.gd b/scripts/partner_ai.gd
new file mode 100644
--- /dev/null
+++ b/scripts/partner_ai.gd
@@ -0,0 +1,103 @@
+extends RefCounted
+
+const Motion = preload("res://scripts/link_motion.gd")
+const CELL := 20.0
+var mode := "follow"
+var target := Vector2.ZERO
+var has_target := false
+var feedback := "跟随"
+var route: Array[Vector2] = []
+var timer := 0.0
+var last_goal := Vector2.INF
+
+func reset() -> void:
+	mode = "follow"
+	has_target = false
+	route.clear()
+	timer = 0.0
+	last_goal = Vector2.INF
+	feedback = "跟随"
+
+func wait() -> void:
+	mode = "wait"
+	has_target = false
+	route.clear()
+	feedback = "原地等待"
+
+func command(point: Vector2, position: Vector2, walls: Array) -> void:
+	target = point
+	has_target = true
+	mode = "goto"
+	route = path(position, point, walls)
+	last_goal = point
+	timer = 0.0
+	feedback = "前往目标" if not route.is_empty() else "不可达目标；右键重选 / E 召回"
+
+static func cell(p: Vector2) -> Vector2i:
+	return Vector2i(roundi(p.x / CELL), roundi(p.y / CELL))
+
+static func point(c: Vector2i) -> Vector2:
+	return Vector2(c) * CELL
+
+static func path(start: Vector2, goal: Vector2, walls: Array) -> Array[Vector2]:
+	var result: Array[Vector2] = []
+	if not Motion.free_at(goal, walls):
+		return result
+	var from := cell(start)
+	var to := cell(goal)
+	if not Motion.free_at(point(from), walls) or not Motion.free_at(point(to), walls):
+		return result
+	var frontier: Array[Vector2i] = [from]
+	var previous := {from: from}
+	var cursor := 0
+	while cursor < frontier.size() and cursor < 2200:
+		var current := frontier[cursor]
+		cursor += 1
+		if current == to:
+			var trace := to
+			while trace != from:
+				result.push_front(point(trace))
+				trace = previous[trace]
+			result.append(goal)
+			return result
+		for offset in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
+			var next: Vector2i = current + offset
+			if next.x < 3 or next.x > 52 or next.y < 8 or next.y > 32 or previous.has(next):
+				continue
+			if Motion.free_at(point(next), walls):
+				previous[next] = current
+				frontier.append(next)
+	return result
+
+func direction(position: Vector2, human: Vector2, walls: Array, hazards: Array, time: float, delta: float) -> Vector2:
+	if mode == "wait":
+		return Vector2.ZERO
+	var goal := target if has_target else human
+	if mode == "follow" and position.distance_to(human) <= 88.0:
+		feedback = "跟随 · 保持间距"
+		return Vector2.ZERO
+	if has_target and position.distance_to(target) < 5.0:
+		mode = "wait"
+		feedback = "到达 · 等待（E 召回）"
+		return Vector2.ZERO
+	timer -= delta
+	if timer <= 0.0 or goal.distance_to(last_goal) > 35.0:
+		route = path(position, goal, walls)
+		last_goal = goal
+		timer = 0.6
+	if route.is_empty():
+		feedback = "不可达目标；右键重选 / E 召回"
+		return Vector2.ZERO
+	while route.size() > 1 and position.distance_to(route[0]) < 5.0:
+		route.pop_front()
+	var move := position.direction_to(route[0])
+	var probe := position + move * 20.0
+	for hazard: Dictionary in hazards:
+		if preload("res://scripts/mechanisms.gd").hazard_phase(time, hazard.offset) != 0 and hazard.rect.grow(14).has_point(probe):
+			feedback = "避险 · 等待激光关闭"
+			return Vector2.ZERO
+	if position.distance_to(human) > 218.5 and move.dot((position - human).normalized()) > 0.02:
+		feedback = "连接限制 · 请玩家靠近"
+		return Vector2.ZERO
+	feedback = "前往目标" if has_target else "跟随 · 绕墙寻路"
+	return move
